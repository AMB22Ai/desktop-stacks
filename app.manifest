<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Built into the exe. With a manifest inside the exe, Windows ignores a
     "DesktopStacks.exe.manifest" file or a ".local" folder placed next to it, which
     could otherwise redirect system DLLs to planted copies. It also states that the
     app never asks for administrator rights. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="DesktopStacks" version="0.1.2.0" processorArchitecture="amd64"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
